# Copy to .env for local dev. In production (Render), set these as environment variables.

# Postgres connection string (from Neon). Looks like:
# postgres://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# A long random secret for signing JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated list of allowed browser origins (no trailing slash).
# Your deployed frontend + localhost for testing:
CORS_ORIGIN=https://vivek-borole.github.io,http://localhost:5500,http://127.0.0.1:5500

# Port (Render sets this automatically; default 3000 locally)
PORT=3000
